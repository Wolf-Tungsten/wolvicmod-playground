package build

import $ivy.`org.chipsalliance::firtool-resolver:2.1.1`
import mill._
import mill.scalalib._

// refgen：对拍参考源生成器。chisel 版本钉死 XiangShan kunminghu-v3 主仓
// （build.mill:19/42：chisel 7.13.0 + scala 2.13.17 + chisel-plugin 7.13.0）。
// 参考 RTL 只引用真实源码，不复制不重写：
//   - chisel3 标准库（util.Queue / Pipe / Arbiter / RRArbiter）随 chisel 依赖
//   - xs-utils 裁剪子集（FastQueue/VipArbiter/ConditionArbiter/SRAM 模板及闭包）
//   - dongjiang utils 的 FastArb.scala / Alloc.scala
//   - rocket-chip cde（Alloc.scala 的 import org.chipsalliance.cde.config 需要）

val wsRoot = os.Path(sys.env("MILL_WORKSPACE_ROOT"))  // verify/refgen（build.mill 所在目录）
val projRoot = wsRoot / ".." / ".."                   // proj-xiangshan-l3
val xsUtilsRoot =
    projRoot / "XiangShan" / "XSCache" / "ZhuJiang" / "xs-utils" / "src" / "main" / "scala"
val dongjiangUtils =
    projRoot / "XiangShan" / "XSCache" / "ZhuJiang" / "src" / "main" / "scala" / "dongjiang" / "utils"

// xs-utils 裁剪子集（整树会拖入 rocket-chip diplomacy/tilelink 全家桶；本子集
// 的 import 闭包只到 firrtl.annotations（chisel jar 内）与 cde）
val xsUtilsSubset = Seq(
  "xs/utils/queue/FastQueue.scala",
  "xs/utils/queue/CircularQueuePtr.scala",
  "xs/utils/queue/MimoQueue.scala",
  "xs/utils/queue/OverrideableQueue.scala",
  "xs/utils/arb/BaseArbiter.scala",
  "xs/utils/arb/VipArbiter.scala",
  "xs/utils/arb/ConditionArbiter.scala",
  "xs/utils/ResetRRArbiter.scala",
  "xs/utils/ResetGen.scala",
  "xs/utils/package.scala",
  "xs/utils/GlobalData.scala",
  "xs/utils/ClockGate.scala",
  "xs/utils/FileRegisters.scala",
  "xs/utils/Hold.scala",
  "xs/utils/dft/package.scala",
  "xs/utils/mbist/Mbist.scala",
  "xs/utils/mbist/MbistBus.scala",
  "xs/utils/mbist/MbistClockGateCell.scala",
  "xs/utils/mbist/MbistCsvGen.scala",
  "xs/utils/mbist/MbistPipeline.scala",
  "xs/utils/sram/SinglePortSramTemplate.scala",
  "xs/utils/sram/DualPortSramTemplate.scala",
  "xs/utils/sram/SRAMTemplate.scala",
  "xs/utils/sram/SramProto.scala",
  "xs/utils/sram/SramHelper.scala",
  "xs/utils/sram/SramInstGen.scala",
  "xs/utils/sram/SramResetGen.scala",
  "xs/utils/sram/SramQueue.scala",
  "sifive/enterprise/firrtl/FullAsyncResetAnnotation.scala",
  "sifive/enterprise/firrtl/NestedPrefixModulesAnnotation.scala",
)

val dongjiangSubset = Seq(
  "FastArb.scala",
  "Alloc.scala",
)

object refgen extends ScalaModule {
  def scalaVersion = "2.13.17"

  def mainClass = Some("refgen.RefGen")

  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations", "-Ytasty-reader")

  def ivyDeps = Agg(
    mvn"org.chipsalliance::chisel:7.13.0",
    mvn"com.lihaoyi::sourcecode:0.4.4",
    mvn"org.chipsalliance::firtool-resolver:2.1.1",  // main() 里直接 Resolve 到缓存的 firtool
  )

  def scalacPluginIvyDeps = Agg(mvn"org.chipsalliance:::chisel-plugin:7.13.0")

  def sources = Task.Sources {
    Seq(PathRef(wsRoot / "src")) ++
      xsUtilsSubset.map(f => PathRef(xsUtilsRoot / os.RelPath(f))) ++
      dongjiangSubset.map(f => PathRef(dongjiangUtils / f)) ++
      Seq(PathRef(projRoot / "XiangShan" / "rocket-chip" / "cde" / "cde" / "src"))
  }
}

// ============ DongJiang 全量参考（P3，步骤 5） ============
// 参考 RTL 同样只引用真实源码。DongJiang 的依赖闭包不可避免：ZhuJiang 整树 +
// xs-utils 整树 + rocket-chip 全树（对齐 XiangShan/XSCache 官方构建的模块划分；
// 曾尝试按需裁剪 diplomacy/util/amba 子集，但 ahb→diplomacy→时钟域→Blockable→
// tile/rocket 的文件级依赖链不可切断，按官方做法全树编译，mill 缓存一次性代价）。
val rcRoot = projRoot / "XiangShan" / "rocket-chip"
val zjRoot = projRoot / "XiangShan" / "XSCache" / "ZhuJiang"

def walkScala(dir: os.Path, exclude: Set[String] = Set()): Seq[PathRef] =
  os.walk(dir).filter(_.ext == "scala").filterNot(f => exclude(f.last)).map(PathRef(_))

// scala2 宏不能与使用方同编译单元 → 独立模块（对应 rocket-chip 官方构建的 macros 子项目）
object rcMacros extends ScalaModule {
  def scalaVersion = "2.13.17"
  def ivyDeps = Agg(mvn"org.scala-lang:scala-reflect:2.13.17")
  def sources = Task.Sources { Seq(PathRef(rcRoot / "macros" / "src" / "main")) }
}

object rcHardfloat extends ScalaModule {
  def scalaVersion = "2.13.17"
  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations", "-Ytasty-reader")
  def ivyDeps = Agg(mvn"org.chipsalliance::chisel:7.13.0")
  def scalacPluginIvyDeps = Agg(mvn"org.chipsalliance:::chisel-plugin:7.13.0")
  def sources = Task.Sources { Seq(PathRef(rcRoot / "hardfloat" / "hardfloat" / "src")) }
}

// rocket-chip 全树（对齐 XiangShan/XSCache 官方构建的 rocketchip 模块）。
// 曾尝试按需裁剪 diplomacy/util/amba 子集，但 ahb→diplomacy→时钟域→Blockable→tile/rocket
// 的文件级依赖链不可切断，按官方做法全树编译（mill 缓存，一次性代价）。
object rcRocketChip extends ScalaModule {
  def scalaVersion = "2.13.17"
  def moduleDeps = Seq(rcMacros, rcHardfloat)
  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations", "-Ytasty-reader", "-language:implicitConversions")
  def ivyDeps = Agg(
    mvn"org.chipsalliance::chisel:7.13.0",
    mvn"com.lihaoyi::sourcecode:0.4.4",
    mvn"com.lihaoyi::mainargs:0.7.0",
    mvn"org.json4s::json4s-jackson:4.0.7",
  )
  def scalacPluginIvyDeps = Agg(mvn"org.chipsalliance:::chisel-plugin:7.13.0")
  def sources = Task.Sources {
    Seq(
      PathRef(rcRoot / "src"),
      PathRef(rcRoot / "cde" / "cde" / "src"),
    )
  }
}

object refgenDj extends ScalaModule {
  def scalaVersion = "2.13.17"

  def moduleDeps = Seq(rcRocketChip)

  def mainClass = Some("refgen.dj.DjRefGen")

  def scalacOptions = Seq("-language:reflectiveCalls", "-Ymacro-annotations", "-Ytasty-reader", "-deprecation", "-feature")

  def ivyDeps = Agg(
    mvn"org.chipsalliance::chisel:7.13.0",
    mvn"com.lihaoyi::sourcecode:0.4.4",
    mvn"com.lihaoyi::mainargs:0.7.0",
    mvn"org.json4s::json4s-jackson:4.0.7",
    mvn"org.scala-lang:scala-reflect:2.13.17",
    mvn"org.chipsalliance::firtool-resolver:2.1.1",
  )

  def scalacPluginIvyDeps = Agg(mvn"org.chipsalliance:::chisel-plugin:7.13.0")

  def sources = Task.Sources {
    Seq(PathRef(wsRoot / "srcdj")) ++
      walkScala(zjRoot / "src" / "main" / "scala") ++
      walkScala(zjRoot / "xs-utils" / "src" / "main" / "scala") ++
      Seq(
        PathRef(projRoot / "XiangShan" / "src" / "main" / "scala" / "top" / "ZhuJiangNoCTopology.scala"),
      )
  }
}
